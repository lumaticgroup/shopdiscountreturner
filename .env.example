TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
DB_PATH=trendyol.db

# Daily digest fires at this local server time
DAILY_DIGEST_HOUR=9
DAILY_DIGEST_MINUTE=0

# Scrape scope. 5 pages per category ≈ ~120 products/category.
MAX_PAGES_PER_CATEGORY=5
SCRAPER_CONCURRENCY=3

# Scrape-level discount floor (all stores): products below this % never
# enter the DB. Lower it (e.g. 20) to show shallower deals in the bot UI;
# CHANNEL_MIN_DISCOUNT_PCT below filters again at posting time, so the
# channel can stay at 35 regardless.
MIN_DISCOUNT_PCT=35

# Bot rendering
DIGEST_TOP_N=20
PAGE_SIZE=10

# any code in the storefront registry (see scraper/stores/*)
# static stores: trendyol_tr, trendyol_uae (Trendyol) · shein_tr, shein_uae (Shein)
DEFAULT_STOREFRONT=trendyol_tr

# Rate limit for on-demand scrapes (seconds)
SCRAPE_CACHE_SECONDS=600

# ≥N% off firehose channel. Bot must be admin with post permission.
# Public channel: @your_channel   Private: numeric id like -1001234567890
TELEGRAM_CHANNEL_ID=
CHANNEL_MIN_DISCOUNT_PCT=35
CHANNEL_POST_RATE_PER_MIN=20

# --- Mini App (Telegram WebApp) hosted by FastAPI in the same process ---
# Set to the HTTPS URL Telegram will reach (ngrok in dev, Caddy/nginx in prod).
WEBAPP_BASE_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
# Random secret for JWT signing. Rotate to invalidate all sessions.
WEBAPP_SECRET=change-me
SESSION_TTL_HOURS=168

# --- First admin (seeded once at startup if no admin exists) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Dynamic stores declared via env ---
# Any env var starting with `STORE_` is parsed as JSON and upserted into the
# `dynamic_stores` table on every startup. Admins can also add/edit stores via
# the Mini App at /admin.html. `flow_type` is one of:
#   "api"    — plain JSON fetch, default headers.
#   "header" — JSON fetch with custom headers and cookies (see the sample).
#
# `config.list_url` and `config.fields` are required. `fields` maps product
# attributes to JSONPath expressions applied to each item in `response_items_path`.
#
# Example (API flow):
# STORE_DUMMY={"code":"dummyjson","display_name":"DummyJSON","flow_type":"api","base_url":"https://dummyjson.com","currency":"USD","storefront_code":"dummy_us","config":{"list_url":"https://dummyjson.com/products?limit=100","response_items_path":"$.products[*]","fields":{"product_id":"$.id","name":"$.title","url":"$.thumbnail","image_url":"$.thumbnail","price":"$.price","original_price":"$.price","discount_pct":"$.discountPercentage","brand":"$.brand"}}}
#
# Example (Header flow — sends a custom User-Agent + cookie you snagged from DevTools):
# STORE_MYSHOP={"code":"myshop","display_name":"My Shop","flow_type":"header","base_url":"https://myshop.com","currency":"EUR","storefront_code":"myshop_eu","config":{"list_url":"https://myshop.com/api/deals","response_items_path":"$.items[*]","headers":{"User-Agent":"Mozilla/5.0 ...","Accept-Language":"de-DE"},"cookies":{"session":"abc123"},"fields":{"product_id":"$.sku","name":"$.title","url":"$.url","image_url":"$.image","price":"$.price.now","original_price":"$.price.was","discount_pct":"$.discount"},"pagination":{"param":"page","start":1,"max":5}}}
